@page
@model JurisControl.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_AuthLayout";
}

<h1 class="auth-title">Iniciar sesión en JurisControl</h1>
<p class="auth-subtitle">Ingresa con la cuenta que te asignó tu despacho.</p>

<form method="post" class="auth-form">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Input.Email" class="form-label">Correo</label>
        <input asp-for="Input.Email" class="form-control" autocomplete="username" autofocus />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Input.Password" class="form-label">Contraseña</label>
        <input asp-for="Input.Password" class="form-control" type="password" autocomplete="current-password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="form-group form-check">
        <input asp-for="Input.RememberMe" class="form-check-input" type="checkbox" />
        <label asp-for="Input.RememberMe" class="form-check-label">Mantener sesión abierta</label>
    </div>

    <button type="submit" class="btn btn-primary btn-block">Entrar</button>
</form>
