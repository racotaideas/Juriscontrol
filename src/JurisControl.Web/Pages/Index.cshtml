@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="page-shell">
    <section class="hero-card">
        <div class="hero-eyebrow">Panel del despacho</div>
        <h1 class="hero-title">@Model.RazonSocial</h1>
        <p class="hero-lead">
            Bienvenido, @Model.NombreUsuario. Estás en el <b>modo @(Model.ModoCobranza ? "cobranza + genérico" : "genérico")</b>
            de JurisControl. Materias activas: <b>@Model.MateriasAtiende</b>.
        </p>
        <div class="hero-meta">
            <span class="chip">Fase 0 · scaffold</span>
            <span class="chip neutral">Despacho: @Model.DespachoId</span>
            <span class="chip good">Tenant OK</span>
        </div>
    </section>

    <section class="cards-row">
        <article class="metric-card">
            <div class="metric-label">Asuntos activos</div>
            <div class="metric-value">—</div>
            <div class="metric-note">Módulo pendiente (Fase 1)</div>
        </article>
        <article class="metric-card">
            <div class="metric-label">Juicios en trámite</div>
            <div class="metric-value">—</div>
            <div class="metric-note">Módulo pendiente (Fase 2)</div>
        </article>
        <article class="metric-card">
            <div class="metric-label">Audiencias esta semana</div>
            <div class="metric-value">—</div>
            <div class="metric-note">Módulo pendiente (Fase 2)</div>
        </article>
        <article class="metric-card">
            <div class="metric-label">Plazos por vencer</div>
            <div class="metric-value">—</div>
            <div class="metric-note">Módulo pendiente (Fase 2)</div>
        </article>
    </section>

    <section class="info-card">
        <h2 class="section-title">Estado técnico de la Fase 0</h2>
        <ul class="checklist">
            <li class="done">Multi-tenant con Global Query Filters + <code>SESSION_CONTEXT</code></li>
            <li class="done">ASP.NET Core Identity con <code>DespachoId</code> en <code>ApplicationUser</code></li>
            <li class="done">Cookie de sesión con claim <code>despacho_id</code></li>
            <li class="done">Seed automático del despacho piloto en el arranque</li>
            <li>CRUD de Clientes (Fase 1)</li>
            <li>CRUD de Asuntos (Fase 1)</li>
            <li>CRUD de Juicios (Fase 2)</li>
        </ul>
    </section>
</div>
