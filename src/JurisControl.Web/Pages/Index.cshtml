@page
@model IndexModel
@using JurisControl.Domain.Enums
@{
    ViewData["Title"] = "Inicio";
}

<div class="page-shell">
    <section class="hero-card">
        <div class="hero-eyebrow">Panel del despacho</div>
        <h1 class="hero-title">@Model.RazonSocial</h1>
        <p class="hero-lead">
            Bienvenido, @Model.NombreUsuario. Estás en el <b>modo @(Model.ModoCobranza ? "cobranza + genérico" : "genérico")</b>
            de JurisControl. Materias activas: <b>@Model.MateriasAtiende</b>.
        </p>
        <div class="hero-meta">
            <span class="chip">Fase 1 · CRUD</span>
            <span class="chip neutral">Despacho: @Model.DespachoId</span>
            <span class="chip good">Tenant OK</span>
        </div>
    </section>

    <section class="cards-row">
        <article class="metric-card">
            <div class="metric-label">Clientes activos</div>
            <div class="metric-value">@Model.ClientesActivos</div>
            <div class="metric-note"><a asp-page="/Clientes/Index">Ver lista</a></div>
        </article>
        <article class="metric-card">
            <div class="metric-label">Asuntos activos</div>
            <div class="metric-value">@Model.AsuntosActivos</div>
            <div class="metric-note"><a asp-page="/Asuntos/Index" asp-route-estado="Activo">Activos + asignados</a></div>
        </article>
        <article class="metric-card">
            <div class="metric-label">Recibidos sin asignar</div>
            <div class="metric-value">@Model.AsuntosRecibidos</div>
            <div class="metric-note"><a asp-page="/Asuntos/Index" asp-route-estado="Recibido">Ver bandeja</a></div>
        </article>
        <article class="metric-card">
            <div class="metric-label">Cerrados este mes</div>
            <div class="metric-value">@Model.AsuntosCerradosMes</div>
            <div class="metric-note"><a asp-page="/Asuntos/Index" asp-route-estado="Cerrado">Ver cerrados</a></div>
        </article>
    </section>

    <section class="info-card">
        <div class="card-head">
            <h2 class="section-title">Últimos asuntos capturados</h2>
            <a asp-page="/Asuntos/Create" class="btn btn-primary btn-sm">+ Nuevo asunto</a>
        </div>
        @if (!Model.UltimosAsuntos.Any())
        {
            <p class="muted">
                No hay asuntos aún. Empieza dando de alta un <a asp-page="/Clientes/Create">cliente</a>
                y luego captura su primer asunto.
            </p>
        }
        else
        {
            <table class="table">
                <thead><tr><th>Folio</th><th>Título</th><th>Cliente</th><th>Estado</th><th>Alta</th></tr></thead>
                <tbody>
                    @foreach (var a in Model.UltimosAsuntos)
                    {
                        <tr>
                            <td><a asp-page="/Asuntos/Details" asp-route-id="@a.Id" class="link-primary">@a.Folio</a></td>
                            <td>@a.Titulo</td>
                            <td>@a.Cliente</td>
                            <td><span class="badge @a.Estado.BadgeClass()">@a.Estado.Label()</span></td>
                            <td>@a.Fecha.LocalDateTime.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</div>
