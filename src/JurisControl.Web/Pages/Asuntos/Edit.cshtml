@page "{id:guid}"
@model JurisControl.Web.Pages.Asuntos.EditModel
@using JurisControl.Domain.Enums
@{
    ViewData["Title"] = $"Editar · {Model.Folio}";
}

<section class="page page-narrow">
    <div class="page-head">
        <div>
            <h1 class="page-title">Editar asunto</h1>
            <p class="page-sub">@Model.Folio</p>
        </div>
        <a asp-page="Details" asp-route-id="@Model.Id" class="btn btn-ghost">Cancelar</a>
    </div>

    <form method="post" class="form-grid card">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert-danger"></div>

        <div class="field-full">
            <label>Título</label>
            <input asp-for="Input.Titulo" class="input" />
        </div>

        <div>
            <label>Cliente</label>
            <select asp-for="Input.ClienteId" asp-items="Model.ClientesList" class="input"></select>
        </div>

        <div>
            <label>Materia</label>
            <select asp-for="Input.MateriaKey" asp-items="Model.MateriasList" class="input"></select>
        </div>

        <div>
            <label>Responsable</label>
            <select asp-for="Input.ResponsableId" asp-items="Model.UsuariosList" class="input">
                <option value="">Sin asignar</option>
            </select>
        </div>

        <div>
            <label>Estado</label>
            <select asp-for="Input.Estado" class="input">
                @foreach (var e in Enum.GetValues<EstadoAsunto>())
                {
                    <option value="@e">@e.Label()</option>
                }
            </select>
        </div>

        <div>
            <label>Fecha de recepción</label>
            <input asp-for="Input.FechaRecepcion" type="date" class="input" />
        </div>

        <div>
            <label>Prioridad</label>
            <input asp-for="Input.Prioridad" type="number" min="1" max="5" class="input" />
        </div>

        <div>
            <label>Cuantía</label>
            <input asp-for="Input.Cuantia" type="number" step="0.01" class="input" />
        </div>

        <div>
            <label>Etiquetas</label>
            <input asp-for="Input.Etiquetas" class="input" />
        </div>

        <div class="field-full">
            <label class="checkbox">
                <input asp-for="Input.EsCobranza" type="checkbox" />
                <span>Módulo de cobranza</span>
            </label>
        </div>

        <div class="field-full">
            <label>Descripción</label>
            <textarea asp-for="Input.Descripcion" class="input textarea" rows="4"></textarea>
        </div>

        <div class="field-full">
            <label>Notas privadas</label>
            <textarea asp-for="Input.NotasPrivadas" class="input textarea" rows="3"></textarea>
        </div>

        <div class="field-full form-actions">
            <button type="submit" class="btn btn-primary">Guardar cambios</button>
        </div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
