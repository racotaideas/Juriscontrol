@using System.Security.Claims
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · JurisControl</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <header class="app-topbar">
        <div class="app-topbar-inner">
            <a class="app-brand" asp-page="/Index">
                <div class="brand-mark">JC</div>
                <span class="brand-name">Juris<b>Control</b></span>
            </a>
            <nav class="app-nav">
                <a asp-page="/Index" class="app-nav-link">Inicio</a>
                <a asp-page="/Asuntos/Index" class="app-nav-link">Asuntos</a>
                <a asp-page="/Juicios/Index" class="app-nav-link">Juicios</a>
                <a asp-page="/Clientes/Index" class="app-nav-link">Clientes</a>
                <a asp-page="/Agenda/Index" class="app-nav-link">Agenda</a>
                <a asp-page="/Cobranza/Index" class="app-nav-link">Cobranza</a>
                <a asp-page="/Plantillas/Index" class="app-nav-link">Plantillas</a>
                <a asp-page="/Gastos/Index" class="app-nav-link">Gastos</a>
                <a asp-page="/Reportes/Index" class="app-nav-link">Reportes</a>
                <a asp-page="/Diagnostico/Index" class="app-nav-link">Diagnóstico</a>
            </nav>
            <div class="app-user">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="app-user-name">@User.Identity.Name</span>
                    <form method="post" asp-page="/Account/Logout" class="d-inline">
                        <button type="submit" class="btn btn-ghost">Salir</button>
                    </form>
                }
            </div>
        </div>
    </header>

    <main class="app-main">
        @RenderBody()
    </main>

    <footer class="app-footer">
        &copy; 2026 Racota Ideas · JurisControl v2 · Fase 0
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
