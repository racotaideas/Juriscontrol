@page
@model JurisControl.Web.Pages.Plantillas.CreateModel
@{
    ViewData["Title"] = "Nueva plantilla";
}

<section class="page">
    <div class="page-head">
        <div>
            <h1 class="page-title">Nueva plantilla</h1>
            <p class="page-sub">Usa tokens {{TOKEN}} en el cuerpo. Se reemplazan al aplicar la plantilla a un asunto.</p>
        </div>
        <a asp-page="Index" class="btn btn-ghost">Cancelar</a>
    </div>

    <div class="grid-2">
        <form method="post" class="form-grid card">
            <div asp-validation-summary="ModelOnly" class="alert-danger"></div>
            <div>
                <label>Clave <span class="req">*</span></label>
                <input asp-for="Input.Clave" class="input" placeholder="CARTA-COBRO-1" />
            </div>
            <div>
                <label>Categoría <span class="req">*</span></label>
                <input asp-for="Input.Categoria" class="input" placeholder="carta, escrito, informe, notificación" />
            </div>
            <div class="field-full">
                <label>Nombre <span class="req">*</span></label>
                <input asp-for="Input.Nombre" class="input" />
            </div>
            <div class="field-full">
                <label>Descripción</label>
                <input asp-for="Input.Descripcion" class="input" placeholder="Cuándo usarla, para qué materia, etc." />
            </div>
            <div class="field-full">
                <label>Cuerpo (usa {{TOKEN}} para variables)</label>
                <textarea asp-for="Input.Cuerpo" class="input textarea" rows="18" style="font-family:var(--font-mono); font-size:13px;"></textarea>
            </div>
            <div class="field-full form-actions">
                <button type="submit" class="btn btn-primary">Guardar plantilla</button>
            </div>
        </form>

        <div class="card">
            <h3>Tokens disponibles</h3>
            <p class="muted">Click para copiar. Pégalos donde los quieras en el cuerpo.</p>
            <ul class="line-list" style="max-height: 600px; overflow-y: auto;">
                @foreach (var t in Model.TokensDisponibles)
                {
                    <li>
                        <code onclick="navigator.clipboard.writeText('{{@t.Token}}');this.classList.add('copied');setTimeout(()=>this.classList.remove('copied'),800);"
                              style="cursor:pointer; background:var(--surface-2); padding:2px 6px; border-radius:4px; font-family:var(--font-mono); font-size:12px;">
                            @($"{{{{{t.Token}}}}}")
                        </code>
                        <div class="muted" style="font-size:12px;">@t.Descripcion</div>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
