<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config personalizado para Fase 0.
  - stdout logging habilitado del AspNetCoreModule para diagnosticar crashes
    de arranque (se lee por FTP en ./App_Data/logs/stdout_*.log).
  - hostingModel="OutOfProcess" porque el pool de SmartASP.NET tiene otras
    apps ASP.NET Core que impedirían InProcess (error 500.35).
  - ASPNETCORE_ENVIRONMENT=Production para que se cargue appsettings.Production.json.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\JurisControl.Web.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\App_Data\logs\stdout"
                  hostingModel="OutOfProcess"
                  startupTimeLimit="120"
                  requestTimeout="00:02:00">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <httpErrors errorMode="Detailed" />
    </system.webServer>
  </location>
</configuration>
