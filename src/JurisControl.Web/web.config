<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config personalizado para Fase 0. Habilita stdout logging del
  AspNetCoreModule, de manera que si la app crashea antes de que el pipeline
  logueé algo, IIS escribe la excepción en ./App_Data/logs/stdout_*.log.
  Ese archivo se lee por FTP.

  El publish de .NET auto-genera un web.config estándar; este archivo lo
  reemplaza al configurar CopyToPublishDirectory en el csproj.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\JurisControl.Web.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\App_Data\logs\stdout"
                  hostingModel="InProcess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <httpErrors errorMode="Detailed" />
    </system.webServer>
  </location>
</configuration>
